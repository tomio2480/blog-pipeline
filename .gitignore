# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/

# Virtualenv
.venv/
venv/
env/

# Test / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment / secrets
.env
.env.*
!.env.example

# Scratch / local notes (never commit)
.scratch/

# Materials and ENEX (利用者がローカルで生成．Public リポジトリには絶対に含めない)
materials/
*.enex
# 例外：合成 fixture（個人情報を含まない）はテスト用にコミットする
!tests/fixtures/*.enex

# prompt-maker の出力先が誤って blog-pipeline 内に落ちても commit されないようにする
# （session_id にイベント名・人名等の固有名詞が含まれうるため．D2 運用では個人化版の cwd へ出力する）
/[0-9][0-9][0-9][0-9]-*/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
